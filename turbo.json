{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "PORT",
    "FRONTEND_PORT",
    "FRONTEND_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_WS_URL",
    "MULTICA_SERVER_URL",
    "DOCS_URL",
    "COMPOSE_PROJECT_NAME",
    "POSTGRES_DB",
    "POSTGRES_PORT",
    "DESKTOP_RENDERER_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "**/*.ts", "**/*.tsx", "**/*.css"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:staging": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^typecheck"]
    },
    "@multica/ios#codegen": {
      "inputs": ["scripts/codegen-types.mjs", "../../packages/core/types/**/*.ts"],
      "outputs": ["Multica/Models/Generated.swift"]
    },
    "@multica/ios#generate": {
      "dependsOn": ["@multica/ios#codegen"],
      "inputs": ["project.yml", "Multica/**", "MulticaTests/**"],
      "outputs": ["Multica.xcodeproj/**"]
    },
    "@multica/ios#build": {
      "dependsOn": ["@multica/ios#generate"],
      "inputs": ["project.yml", "Multica/**", "MulticaTests/**"],
      "outputs": ["build/**", "Multica.xcodeproj/**"],
      "cache": false
    },
    "@multica/ios#test": {
      "dependsOn": ["@multica/ios#generate"],
      "inputs": ["project.yml", "Multica/**", "MulticaTests/**"],
      "cache": false
    }
  }
}
